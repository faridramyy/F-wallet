# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# AWS IAM credentials (long-term keys for an IAM user with dsql:DbConnect permission).
# These replace SSO so you never need to run `aws sso login` for local dev.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Aurora DSQL
DB_HOST=your-cluster.dsql.ca-central-1.on.aws
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-database-user
DB_MAX_CONNECTIONS=3

# AWS Cognito
COGNITO_REGION=your_aws_region
COGNITO_USER_POOL_ID=your_cognito_user_pool_id
COGNITO_CLIENT_ID=your_cognito_app_client_id
