# Copy to .env for local development. In production these are Lambda
# environment variables set in template.yaml or the AWS console.

MONGODB_URI=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Generate with: npm run hash-password -- "your password here"
PASSWORD_HASH=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

ALLOWED_ORIGINS=

TOKEN_TTL=
PORT=
